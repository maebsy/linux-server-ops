# =============================================================================
#  agent-sshd.local — SSH(20022) 무차별 대입 자동 차단 fail2ban jail
#
#  설치: setup/08-fail2ban.sh (선택 단계) → /etc/fail2ban/jail.d/agent-sshd.local
#
#  기준 근거: SSH 포트를 20022 로 옮기고 root 원격 로그인을 막은(01-ssh.sh) 위에,
#  남은 봇의 비밀번호 추측 시도를 자동으로 차단한다. 아래 값은 "사람의 정상 오타는
#  살려 두고, 봇의 기계적 연속 시도만 막는다" 는 기준으로 정했다.
# =============================================================================
[sshd]
# fail2ban 설정은 값 뒤에 '# 주석' 을 붙이면 그 주석까지 값으로 읽는다
# (실측: maxretry 가 무효 처리되고 banaction 이 "ufw # …" 로 읽혀 jail 전체가 꺼짐).
# 그래서 주석은 반드시 값 위의 별도 줄에 둔다.
enabled = true

# 01-ssh.sh 로 옮긴 SSH 포트 (기본 22 가 아님)
port = 20022

# 10분 안에 5회 실패하면 차단: 사람의 오타는 걸리지 않고 봇의 연속 시도는 걸리는 수준
maxretry = 5
findtime = 10m

# 1시간 차단: 오탐(사람)이어도 손대지 않으면 1시간 뒤 자동 해제
bantime = 1h

# 차단을 UFW 규칙으로 넣어 `ufw status` 에 보이게 한다 (기존 방화벽과 한 곳에서 관리)
banaction = ufw

# 로컬호스트는 차단 대상에서 제외 (관리자 고정 IP 가 있으면 여기에 추가해 자기 잠김 방지)
ignoreip = 127.0.0.1/8 ::1
