# =============================================================================
#  monitor-nginx.env — 관제 대상을 agent-app 에서 Nginx 로 바꿀 때 쓰는 환경 파일
#
#  monitor.sh 는 시작하면서 `source "$AGENT_ENV_FILE"` 로 이 파일을 읽는다.
#  그래서 이 파일은 bash 조각이다 (KEY=VALUE, 주석은 #).
#
#  설치: sudo install -m 0640 -o root -g agent-core config/examples/monitor-nginx.env /etc/agent-app/
#  사용법: crontab 의 해당 줄에서만 이 파일을 가리킨다(crontab 은 줄을 이을 수 없으니 한 줄로). 공용 env 는 그대로 둔다.
#    * * * * * AGENT_ENV_FILE=/etc/agent-app/monitor-nginx.env /home/agent-admin/agent-app/bin/monitor.sh --no-stats --quiet >> /var/log/agent-app/cron-nginx.log 2>&1
#  절차·실측: docs/webserver-migration.md, docs/evidence/23-nginx-migration.txt
#
#  주의: 공용 env(/etc/agent-app/agent-app.env)의 AGENT_PORT 를 직접 80 으로 바꾸면
#        agent-app 실행(run-agent.sh)도 같은 값을 읽어 앱이 엉뚱한 포트로 뜬다.
#        그래서 포트·프로세스 같은 "관제 대상" 값만 별도 파일로 분리한다.
# =============================================================================

# 공통값(AGENT_HOME, AGENT_LOG_DIR, 키 경로 등)은 공용 env 에서 그대로 가져온다
[ -r /etc/agent-app/agent-app.env ] && . /etc/agent-app/agent-app.env

# ----------------------------------------------------------------- 관제 대상 덮어쓰기
# 프로세스: nginx 는 실행 후 자기 명령줄을 "nginx: master process /usr/sbin/nginx ...",
#           "nginx: worker process" 로 바꾼다. monitor.sh 가 비교하는 argv[0] basename 은
#           실측에서 "nginx -g daemon on; master_process on;"(master) 와 "nginx: worker process"(worker).
#           그래서 '^nginx$' 로는 하나도 못 찾고, 뒤에 ":" 또는 공백이 붙는 경우까지 받아야 한다.
APP_PROCESS_REGEX='^nginx([: ].*)?$'
APP_PROCESS_LABEL=nginx

# 포트: HTTP 80. HTTPS(443)도 보려면 crontab 에 AGENT_PORT=443 줄을 하나 더 둔다.
AGENT_PORT=80

# 실행 계정 제한 해제: master 는 root, worker 는 www-data 라 한 계정으로 묶을 수 없다.
# (빈 값이면 monitor.sh 가 계정으로 프로세스를 거르지 않는다)
APP_USER=

# 모니터 로그는 기존 agent-app 기록과 섞이지 않게 분리한다
MONITOR_LOG=/var/log/agent-app/monitor-nginx.log

# 임계값: 웹서버 출발값. 1주일 baseline 을 report.sh 로 본 뒤 조정한다.
CPU_WARN=70
MEM_WARN=80
DISK_WARN=80
